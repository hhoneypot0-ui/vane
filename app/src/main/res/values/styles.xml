<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Vane" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/launch_bg</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <!-- 底部面板：ColorOS 那种弹性上滑 + 模糊背景 -->
    <style name="SheetAnim">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
